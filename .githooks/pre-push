#!/usr/bin/env bash
#
# Pre-push hook: blocks push to main if backend e2e fail.
# Bypass with: git push --no-verify
#
# Setup (once per clone):
#   git config core.hooksPath .githooks

set -e

protected_branch_re='^refs/heads/main$'
skip=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" =~ $protected_branch_re ]]; then
    skip=1
    echo "▶ pre-push: ${remote_ref} is protected — running backend e2e..."
    break
  fi
done

if [ "$skip" -eq 0 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)/services/backend"

if [ ! -d node_modules ]; then
  echo "▶ pre-push: node_modules missing — running pnpm install..."
  pnpm install --frozen-lockfile
fi

if ! pnpm test:e2e; then
  echo ""
  echo "✗ pre-push blocked: e2e failed."
  echo "  Fix the tests, or bypass with: git push --no-verify"
  exit 1
fi

echo "✓ pre-push: e2e passed"
