# =============================================================================
# SHIK Platform — production env (VPS Timeweb Cloud, РФ).
# Скопируйте в deploy/.env.production и заполните реальными значениями.
# deploy/.env.production НЕ коммитится (в .gitignore).
# =============================================================================

# ----- Домен и SSL -----
# Домен должен быть делегирован на IP VPS (A-запись). Подставляется в nginx.conf.
DOMAIN=shik-roll.ru
API_DOMAIN=api.shik-roll.ru
KDS_DOMAIN=kds.shik-roll.ru
LETSENCRYPT_EMAIL=arslan.1mob.dev.code@gmail.com

# Flutter Web compile-time configuration (not secrets).
API_BASE_URL=https://api.shik-roll.ru
BRAND_ID=37b84f4c-0a70-4263-bfa0-cc04ba0d4b99
BRANCH_ID=47ad77ce-acf4-4778-a185-974d3a4a2413

# ----- PostgreSQL (152-ФЗ: данные локализованы на VPS в РФ) -----
POSTGRES_USER=shik
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=shik_roll

# ----- Backend (NestJS) -----
NODE_ENV=production
PORT=3000
# Хост/порт — внутренние имена сервисов в shik_network
DATABASE_URL=postgresql://shik:CHANGE_ME_STRONG_PASSWORD@postgres:5432/shik_roll?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS
JWT_ACCESS_TTL_SECONDS=2592000
JWT_REFRESH_TTL_SECONDS=7776000
CORS_ORIGIN=https://shik-roll.ru,https://api.shik-roll.ru,https://kds.shik-roll.ru

# ----- Интеграции -----
PAYMENTS_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://shik-roll.ru/order-status
YOOKASSA_MOCK=false
YOOKASSA_VAT_CODE=1
# Необязательно: код системы налогообложения 1..6.
YOOKASSA_TAX_SYSTEM_CODE=
DADATA_API_KEY=CHANGE_ME
