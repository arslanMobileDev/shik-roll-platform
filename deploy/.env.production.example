# =============================================================================
# SHIK Platform — production env (VPS Timeweb Cloud, РФ).
# Скопируйте в deploy/.env.production и заполните реальными значениями.
# deploy/.env.production НЕ коммитится (в .gitignore).
# =============================================================================

# ----- Домен и SSL -----
# Домен должен быть делегирован на IP VPS (A-запись). Подставляется в nginx.conf.
DOMAIN=shik.example.ru
LETSENCRYPT_EMAIL=admin@example.ru

# ----- PostgreSQL (152-ФЗ: данные локализованы на VPS в РФ) -----
POSTGRES_USER=shik
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=shik_roll

# ----- Backend (NestJS) -----
NODE_ENV=production
PORT=3000
# Хост/порт — внутренние имена сервисов в shik_network
DATABASE_URL=postgresql://shik:CHANGE_ME_STRONG_PASSWORD@postgres:5432/shik_roll
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS

# ----- Интеграции -----
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME
DADATA_API_KEY=CHANGE_ME
