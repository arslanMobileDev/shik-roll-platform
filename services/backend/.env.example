# PostgreSQL connection used by Prisma (DB-601 / ADR-1604).
# Local development defaults to the docker-compose PostgreSQL container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shik_menu?schema=public"

# Dedicated database for e2e tests (reset automatically by test setup).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/shik_menu_test?schema=public"

# HTTP port of the NestJS application.
PORT=3000

# YooKassa (local/test defaults to the mock provider)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shikroll.ru/order-status
YOOKASSA_MOCK=true

# Guest auth (auth bounded context).
# HMAC secret for JWT access/refresh tokens — REQUIRED in production.
JWT_SECRET="change-me-in-production"
# Token lifetimes (seconds): access 30 days, refresh 90 days.
# JWT_ACCESS_TTL_SECONDS=2592000
# JWT_REFRESH_TTL_SECONDS=7776000
# OTP lifetime (seconds), default 180 (3 minutes).
# OTP_TTL_SECONDS=180
# SMS provider identifier. When unset (dev/test), the OTP is the fixed code
# "1234" and is logged to the console instead of being sent.
# SMS_PROVIDER=
# Redis connection for the OTP store (falls back to in-memory when unset).
# REDIS_URL="redis://localhost:6379"

# Kitchen POS (ADR-1618).
# Terminal access token lifetime (seconds), default 12 hours (one work shift).
# KITCHEN_TOKEN_TTL_SECONDS=43200
# Redis Pub/Sub channel prefix for the branch board fan-out. When REDIS_URL /
# REDIS_HOST are set, kitchen events fan out over Redis Pub/Sub; otherwise an
# in-process bus is used (unit tests, DISABLE_QUEUES e2e).
# KITCHEN_CHANNEL_PREFIX="kitchen.branch."
# SSE heartbeat cadence (ms), default 15000 (contract: at least one per 20 s).
# KITCHEN_SSE_HEARTBEAT_MS=15000
# Automatic order-status simulation has been removed. Legacy flags
# KDS_STATUS_EMULATION_ENABLED=true / ORDER_AUTO_STATUS_ADVANCE_ENABLED=true
# are rejected during startup.

# Menu image uploads (ADR-008).
# Root for processed images; /uploads/menu/ is served from <root>/menu.
# UPLOADS_ROOT=uploads
# Comma-separated staff UUIDs allowed to upload menu media. When empty or
# unset there is no trusted staff provider and POST /uploads/menu is denied
# for everyone (deny-by-default, never public).
# BACKOFFICE_STAFF_IDS=
