# SHIK Platform backend — production environment template.
# Copy to the secret store/deployment environment and replace every placeholder.

NODE_ENV=production
PORT=3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://user:password@postgres:5432/shik_roll?schema=public

# BullMQ, OTP storage and other Redis-backed services
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication — generate a long cryptographically random value.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=2592000
JWT_REFRESH_TTL_SECONDS=7776000

# YooKassa. Real credentials are mandatory when YOOKASSA_MOCK=false.
PAYMENTS_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://shik-roll.ru/order-status
YOOKASSA_MOCK=false
YOOKASSA_VAT_CODE=1
# Optional tax system code (1..6); leave empty when configured in YooKassa.
YOOKASSA_TAX_SYSTEM_CODE=

# Comma-separated browser origins. Do not use "*" with credentials.
CORS_ORIGIN=https://shik-roll.ru,https://api.shik-roll.ru,https://kds.shik-roll.ru

# Automatic status-simulation flags must not be set in production.

# Menu image uploads (ADR-008). UPLOADS_ROOT must match the uploads volume
# mount point in deploy/docker-compose.*.yml (shared with Nginx read-only).
UPLOADS_ROOT=/app/uploads
# Comma-separated staff UUIDs allowed to upload menu media. When empty,
# POST /uploads/menu is denied for everyone (deny-by-default).
BACKOFFICE_STAFF_IDS=
