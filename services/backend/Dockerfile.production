# syntax=docker/dockerfile:1
# SHIK Platform — production-образ бэкенда (NestJS + Prisma)
# Сборка:  docker build -f Dockerfile.production -t shik-backend:production .

# ---------- base ----------
FROM node:22-alpine AS base
# openssl/libc6-compat — обязательны для Prisma engines на Alpine (musl)
RUN apk add --no-cache openssl libc6-compat \
  && corepack enable \
  && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# ---------- builder: полные зависимости, генерация Prisma Client, компиляция ----------
FROM base AS builder
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec prisma generate \
  && pnpm run build

# ---------- runner: только production-зависимости ----------
FROM base AS runner
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
# prisma CLI находится в dependencies — нужен для `prisma migrate deploy` при старте
RUN pnpm install --prod --frozen-lockfile \
  && pnpm exec prisma generate
COPY --from=builder /app/dist ./dist
COPY docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh \
  && chown -R node:node /app
USER node
EXPOSE 3000
ENTRYPOINT ["./docker-entrypoint.sh"]
