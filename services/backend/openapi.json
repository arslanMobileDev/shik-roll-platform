    "/menu-items": {
      "get": {
        "operationId": "MenuController_getItems",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "brandId",
            "required": false,
            "in": "query",
            "description": "Filter items by brand",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "branchId",
            "required": false,
            "in": "query",
            "description": "Branch context: resolves branch price override, availability and stop list",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "required": false,
            "in": "query",
            "description": "Filter items by category",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Admin filter by lifecycle status. When omitted, the public catalog returns PUBLISHED items only (BE-906).",
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "PUBLISHED",
                "HIDDEN",
                "ARCHIVED"
              ]
            }
          },
          {
            "name": "isHalal",
            "required": false,
            "in": "query",
            "description": "Only items holding a valid HALAL certification tag",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "availableOnly",
            "required": false,
            "in": "query",
            "description": "Excludes items that are unavailable or stop-listed for the given branchId",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive search by name, SKU or description",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemPage"
                }
              }
            }
          }
        },
        "summary": "List menu items with brand/branch/category filters, Halal filter, availability filter, search and pagination",
        "tags": [
          "Menu",
          "menu-items"
        ]
      },
