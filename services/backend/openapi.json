  "info": {
    "title": "SHIK Platform — Menu & Product API",
    "description": "Menu & Product catalog API (API-706, DB-607, BE-906)",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "menus",
      "description": ""
    },
    {
      "name": "categories",
      "description": ""
    },
    {
      "name": "menu-items",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "MenuEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "branchId": {
            "type": "object",
            "nullable": true,
            "description": "null — brand-level default menu"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "UNPUBLISHED"
            ]
          },
          "currentVersion": {
            "type": "object",
            "nullable": true,
            "description": "Current published version number (menu_versions)"
          },
          "publishedAt": {
            "type": "object",
            "nullable": true
          },
          "unpublishedAt": {
            "type": "object",
            "nullable": true
          },
          "categoryCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "brandId",
          "name",
          "status",
          "categoryCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "MenuPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuEntity"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CategoryEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "menuId": {
            "type": "string"
          },
          "parentId": {
            "type": "object",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "imageUrl": {
            "type": "object",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          },
          "isActive": {
            "type": "boolean"
          },
          "itemCount": {
            "type": "number",
            "description": "Number of active items in the category"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "brandId",
          "menuId",
          "name",
          "sortOrder",
          "isActive",
          "itemCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "CategoryPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryEntity"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "menuId": {
            "type": "string",
            "description": "Menu the category belongs to"
          },
          "parentId": {
            "type": "string",
            "description": "Parent category for a sub-category"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          },
          "isActive": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "menuId",
          "name"
        ]
      },
      "ReorderDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "UUIDs in the desired order; index becomes sortOrder",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "description": "Parent category for a sub-category"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          },
          "isActive": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "MenuItemCategoryRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "menuId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "menuId"
        ]
      },
      "MenuItemPriceEntity": {
        "type": "object",
        "properties": {
          "base": {
            "type": "number",
            "description": "Base price from the product card"
          },
          "branch": {
            "type": "object",
            "nullable": true,
            "description": "Branch override; null when the branch has no override or no branchId was passed"
          },
          "effective": {
            "type": "number",
            "description": "Selling price for the requested branch: branch ?? base"
          },
          "currency": {
            "type": "string",
            "example": "RUB"
          }
        },
        "required": [
          "base",
          "effective",
          "currency"
        ]
      },
      "BranchAvailabilityEntity": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "object",
            "nullable": true,
            "description": "Branch context the flag was resolved for; null when no branchId was passed"
          },
          "isAvailable": {
            "type": "boolean",
            "description": "true unless an explicit per-branch override disables the item"
          }
        },
        "required": [
          "isAvailable"
        ]
      },
      "StopListStatusEntity": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "description": "true when an active stop list entry exists for the branch"
          },
          "reason": {
            "type": "object",
            "nullable": true
          },
          "since": {
            "type": "object",
            "nullable": true,
            "description": "Entry start timestamp (ISO 8601)"
          }
        },
        "required": [
          "isActive"
        ]
      },
      "CertificationEntity": {
        "type": "object",
        "properties": {
          "tagId": {
            "type": "string"
