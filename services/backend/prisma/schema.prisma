// SHIK Platform — Menu & Product catalog schema.
// Governing documents: DB-607 (Menu & Product Schema), DB-606 (Restaurant & Branch),
// DB-602 (Database Standards), API-706, BE-906, ADR-1607 (Prisma as data access layer).
//
// Conventions (DB-602):
//   - snake_case plural table names, snake_case columns (via @@map / @map);
//   - UUID primary keys (v4 fallback of the UUID v7 standard — Prisma client-side generation);
//   - timestamptz columns, UTC;
//   - soft delete via deleted_at on business tables;
//   - indexes named idx_<table>_<column>, unique constraints uq_<table>_<column>,
//     foreign keys fk_<table>_<reference>.
//
// Money: Decimal(10,2) in RUB, as explicitly authorized by the package task
// (deviates from the DB-602 "integer minor units" default).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// Product lifecycle (DB-607 v1.2.0): the single lifecycle field of products;
// a separate products.is_active flag is not used.
enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

// ---------------------------------------------------------------------------
// Tenancy: brands and branches (multi-brand support, BrandBranch junction).
// In the catalog bounded context Brand plays the tenant role; the Restaurant
// aggregate from DB-606 belongs to the Restaurant bounded context.
// ---------------------------------------------------------------------------

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    // e.g. SHIK_ROLL
  name      String
  legalName String?   @map("legal_name")
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  brandBranches   BrandBranch[]
  menus           Menu[]
  categories      Category[]
  menuItems       MenuItem[]
  ingredients     Ingredient[]
  modifierGroups  ModifierGroup[]
  orders          Order[]

  @@unique([code], map: "uq_brands_code")
  @@index([status], map: "idx_brands_status")
  @@map("brands")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  code      String // short branch code, unique across the platform
  name      String
  address   String?
  phone     String?
  email     String?
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  brandBranches BrandBranch[]
  menus         Menu[]
  prices        MenuItemPrice[]
  availability  BranchMenuItemAvailability[]
  stopList      StopListEntry[]
  orders        Order[]

  @@unique([code], map: "uq_branches_code")
  @@index([status], map: "idx_branches_status")
  @@map("branches")
}

// Which brands operate at which branches.
model BrandBranch {
  id        String   @id @default(uuid()) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_brand_branches_brands")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_brand_branches_branches")

  @@unique([brandId, branchId], map: "uq_brand_branches_brand_id_branch_id")
  @@index([branchId], map: "idx_brand_branches_branch_id")
  @@map("brand_branches")
}

// ---------------------------------------------------------------------------
// Menu tree: menus -> menu_categories -> products (DB-607).
// branch_id = NULL marks the brand-level default menu.
// ---------------------------------------------------------------------------

model Menu {
  id             String    @id @default(uuid()) @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  name           String
  status         MenuStatus @default(DRAFT)
  currentVersion Int?      @map("current_version") // menu_versions.number, set on publish
  draftUpdatedAt DateTime? @map("draft_updated_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  unpublishedAt  DateTime? @map("unpublished_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_menus_brands")
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_menus_branches")
  categories Category[]
  items      MenuItem[]

  @@index([brandId], map: "idx_menus_brand_id")
  @@index([branchId], map: "idx_menus_branch_id")
  @@index([status], map: "idx_menus_status")
  @@map("menus")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  menuId      String    @map("menu_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(false) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)

  brand    Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_menu_categories_brands")
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Restrict, map: "fk_menu_categories_menus")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, map: "fk_menu_categories_parent")
  children Category[] @relation("CategoryTree")
  items    MenuItem[]

  // DB-607: unique id + menu_id — anchor of the products compound FK.
  @@unique([id, menuId], map: "uq_menu_categories_id_menu_id")
  @@index([brandId], map: "idx_menu_categories_brand_id")
  @@index([menuId], map: "idx_menu_categories_menu_id")
  @@index([parentId], map: "idx_menu_categories_parent_id")
  @@map("menu_categories")
}

// MenuItem is mapped to the canonical "products" table (DB-607 v1.2.0).
// Lifecycle is governed by status only; a separate is_active flag is not used.
// brand_id is a platform extension over DB-607 for direct multi-brand isolation.
model MenuItem {
  id              String        @id @default(uuid()) @db.Uuid
  brandId         String        @map("brand_id") @db.Uuid
  menuId          String        @map("menu_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  sourceKey       String?       @map("source_key") // stable external import key within the menu
  sku             String
  name            String
  slug            String
  description     String?
  weight          Decimal?      @db.Decimal(10, 3)
  calories        Int?
  preparationTime Int?          @map("preparation_time") // minutes
  status          ProductStatus @default(DRAFT)
  sortOrder       Int           @default(0) @map("sort_order")
  isPopular       Boolean       @default(false) @map("is_popular")
  isNew           Boolean       @default(false) @map("is_new")
  isFeatured      Boolean       @default(false) @map("is_featured")
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  hiddenAt        DateTime?     @map("hidden_at") @db.Timestamptz(6)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(6)
  basePrice       Decimal       @map("base_price") @db.Decimal(10, 2)
  currency        String        @default("RUB")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid
  version         Int           @default(1)

  brand           Brand                        @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_products_brands")
  menu            Menu                         @relation(fields: [menuId], references: [id], onDelete: Restrict, map: "fk_products_menus")
  // Compound FK (category_id, menu_id) -> menu_categories(id, menu_id) keeps
  // a product and its category inside the same menu (DB-607 constraint).
  category        Category                     @relation(fields: [categoryId, menuId], references: [id, menuId], onDelete: Restrict, map: "fk_products_menu_categories")
  ingredients     MenuItemIngredient[]
  certifications  MenuItemCertification[]
  prices          MenuItemPrice[]
  availability    BranchMenuItemAvailability[]
  stopList        StopListEntry[]
  modifierGroups  MenuItemModifierGroup[]
  orderItems      OrderItem[]

  @@unique([brandId, sku], map: "uq_products_brand_id_sku")
  @@unique([brandId, slug], map: "uq_products_brand_id_slug")
  @@unique([menuId, sourceKey], map: "uq_products_menu_id_source_key")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([menuId], map: "idx_products_menu_id")
  @@index([brandId], map: "idx_products_brand_id")
  @@index([status], map: "idx_products_status")
  @@index([sourceKey], map: "idx_products_source_key")
  @@index([name], map: "idx_products_name")
  @@map("products")
}

// ---------------------------------------------------------------------------
// Ingredients and product composition.
// ---------------------------------------------------------------------------

model Ingredient {
  id        String    @id @default(uuid()) @db.Uuid
  brandId   String    @map("brand_id") @db.Uuid
  name      String
  unit      String    @default("g") // g | ml | pcs
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  brand     Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_ingredients_brands")
  menuItems MenuItemIngredient[]

  @@unique([brandId, name], map: "uq_ingredients_brand_id_name")
  @@index([brandId], map: "idx_ingredients_brand_id")
  @@map("ingredients")
}

model MenuItemIngredient {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @map("product_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal? @db.Decimal(10, 3)
  unit         String? // overrides the ingredient default unit when set
  isOptional   Boolean  @default(false) @map("is_optional")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_product_ingredients_products")
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, map: "fk_product_ingredients_ingredients")

  @@unique([menuItemId, ingredientId], map: "uq_product_ingredients_product_id_ingredient_id")
  @@index([ingredientId], map: "idx_product_ingredients_ingredient_id")
  @@map("product_ingredients")
}

// ---------------------------------------------------------------------------
// Certification tags (Halal etc.) — generalizes DB-607 halal_labels.
// ---------------------------------------------------------------------------

model CertificationTag {
  id          String    @id @default(uuid()) @db.Uuid
  code        String // stable machine code, e.g. HALAL
  name        String
  description String?
  icon        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)

  items MenuItemCertification[]

  @@unique([code], map: "uq_certification_tags_code")
  @@map("certification_tags")
}

model MenuItemCertification {
  id                String    @id @default(uuid()) @db.Uuid
  menuItemId        String    @map("product_id") @db.Uuid
  tagId             String    @map("tag_id") @db.Uuid
  certificateNumber String?   @map("certificate_number")
  issuedBy          String?   @map("issued_by")
  validFrom         DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_product_certifications_products")
  tag      CertificationTag @relation(fields: [tagId], references: [id], onDelete: Restrict, map: "fk_product_certifications_certification_tags")

  @@unique([menuItemId, tagId], map: "uq_product_certifications_product_id_tag_id")
  @@index([tagId], map: "idx_product_certifications_tag_id")
  @@map("product_certifications")
}

// ---------------------------------------------------------------------------
// Pricing, per-branch availability and stop list (DB-607 business rules:
// price, availability and stop list are resolved per branch).
// ---------------------------------------------------------------------------

// Branch price override. One current row per (product, branch); the effective
// price is the override when present, otherwise products.base_price.
model MenuItemPrice {
  id         String    @id @default(uuid()) @db.Uuid
  menuItemId String    @map("product_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  price      Decimal   @db.Decimal(10, 2)
  oldPrice   Decimal?  @map("old_price") @db.Decimal(10, 2)
  currency   String    @default("RUB")
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version    Int       @default(1)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_product_prices_products")
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_product_prices_branches")

  @@unique([menuItemId, branchId], map: "uq_product_prices_product_id_branch_id")
  @@index([branchId], map: "idx_product_prices_branch_id")
  @@map("product_prices")
}

model BranchMenuItemAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  menuItemId  String   @map("product_id") @db.Uuid
  isAvailable Boolean  @default(false) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_branch_product_availability_branches")
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_branch_product_availability_products")

  @@unique([branchId, menuItemId], map: "uq_branch_product_availability_branch_id_product_id")
  @@index([menuItemId], map: "idx_branch_product_availability_product_id")
  @@map("branch_product_availability")
}

model StopListEntry {
  id         String    @id @default(uuid()) @db.Uuid
  menuItemId String    @map("product_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  reason     String?
  startsAt   DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive   Boolean   @default(false) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version    Int       @default(1)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_stop_list_products")
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_stop_list_branches")

  @@unique([menuItemId, branchId], map: "uq_stop_list_product_id_branch_id")
  @@index([branchId], map: "idx_stop_list_branch_id")
  @@map("stop_list")
}

// ---------------------------------------------------------------------------
// Modifier tree: modifier_groups -> modifiers, bound to products
// through product_modifiers (DB-607).
// ---------------------------------------------------------------------------

model ModifierGroup {
  id            String                 @id @default(uuid()) @db.Uuid
  brandId       String                 @map("brand_id") @db.Uuid
  name          String
  selectionType ModifierSelectionType  @default(SINGLE) @map("selection_type")
  minSelected   Int                    @default(0) @map("min_selected")
  maxSelected   Int?                   @map("max_selected")
  isRequired    Boolean                @default(false) @map("required")
  sortOrder     Int                    @default(0) @map("sort_order")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?                @map("created_by") @db.Uuid
  updatedBy     String?                @map("updated_by") @db.Uuid
  version       Int                    @default(1)

  brand     Brand                    @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_modifier_groups_brands")
  items     ModifierItem[]
  menuItems MenuItemModifierGroup[]

  @@index([brandId], map: "idx_modifier_groups_brand_id")
  @@map("modifier_groups")
}

// ModifierItem is mapped to the canonical "modifiers" table (DB-607).
model ModifierItem {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("RUB")
  calories  Int?
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "fk_modifiers_modifier_groups")

  orderItemModifiers OrderItemModifier[]

  @@index([groupId], map: "idx_modifiers_group_id")
  @@map("modifiers")
}

model MenuItemModifierGroup {
  id              String   @id @default(uuid()) @db.Uuid
  menuItemId      String   @map("product_id") @db.Uuid
  modifierGroupId String   @map("modifier_group_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "fk_product_modifiers_products")
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict, map: "fk_product_modifiers_modifier_groups")

  @@unique([menuItemId, modifierGroupId], map: "uq_product_modifiers_product_id_modifier_group_id")
  @@index([modifierGroupId], map: "idx_product_modifiers_modifier_group_id")
  @@map("product_modifiers")
}

// ---------------------------------------------------------------------------
// Order management (DB-608). Bounded context: orders.
// Money: Decimal(10,2) in RUB (same task-authorized deviation as the catalog).
// Order status transitions are governed by the state machine in
// modules/orders (NEW -> CONFIRMED -> COOKING -> READY -> COMPLETED | CANCELLED).
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  COOKING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @map("order_number")
  status          OrderStatus @default(NEW)
  type            OrderType
  brandId         String      @map("brand_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  customerId      String?     @map("customer_id") @db.Uuid // guest who placed the order (mobile app)
  tableNumber     String?     @map("table_number") // DINE_IN
  deliveryAddress String?     @map("delivery_address") // DELIVERY
  comment         String?
  subtotalAmount  Decimal     @default(0) @map("subtotal_amount") @db.Decimal(10, 2)
  totalAmount     Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  currency        String      @default("RUB")
  estimatedReadyAt DateTime?  @map("estimated_ready_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?     @map("cancel_reason")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?     @map("created_by") @db.Uuid
  updatedBy       String?     @map("updated_by") @db.Uuid
  version         Int         @default(1)

  brand    Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "fk_orders_brands")
  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_orders_branches")
  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict, map: "fk_orders_customers")
  items    OrderItem[]
  history  OrderStatusHistory[]

  @@unique([orderNumber], map: "uq_orders_order_number")
  @@index([brandId], map: "idx_orders_brand_id")
  @@index([branchId], map: "idx_orders_branch_id")
  @@index([customerId], map: "idx_orders_customer_id")
  @@index([status], map: "idx_orders_status")
  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Guest customers (mobile app). Bounded context: auth.
// A customer is auto-provisioned on the first successful OTP verification;
// phone is the single sign-in identifier (E.164, +7XXXXXXXXXX).
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   // E.164, unique sign-in identifier
  name      String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@unique([phone], map: "uq_customers_phone")
  @@map("customers")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  menuItemId   String   @map("product_id") @db.Uuid
  name         String // snapshot of the product name at order time
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(10, 2)
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_order_items_orders")
  menuItem  MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict, map: "fk_order_items_products")
  modifiers OrderItemModifier[]

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([menuItemId], map: "idx_order_items_product_id")
  @@map("order_items")
}

model OrderItemModifier {
  id             String   @id @default(uuid()) @db.Uuid
  orderItemId    String   @map("order_item_id") @db.Uuid
  modifierItemId String   @map("modifier_id") @db.Uuid
  name           String // snapshot of the modifier name at order time
  priceDelta     Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade, map: "fk_order_item_modifiers_order_items")
  modifierItem ModifierItem @relation(fields: [modifierItemId], references: [id], onDelete: Restrict, map: "fk_order_item_modifiers_modifiers")

  @@index([orderItemId], map: "idx_order_item_modifiers_order_item_id")
  @@index([modifierItemId], map: "idx_order_item_modifiers_modifier_id")
  @@map("order_item_modifiers")
}

// Append-only audit of order status transitions (DB-608: every status change
// is recorded in history).
model OrderStatusHistory {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  previousStatus OrderStatus @map("previous_status")
  newStatus      OrderStatus @map("new_status")
  changedBy      String?     @map("changed_by") @db.Uuid
  reason         String?
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_order_status_history_orders")

  @@index([orderId], map: "idx_order_status_history_order_id")
  @@map("order_status_history")
}
